# このファイルを scripts/.env にコピーして値を埋めてください。
# scripts/.env は .gitignore 済み。絶対にGitにコミットしないこと。

# ---- Bluesky ----
# アプリパスワードを使うこと（本パスワードは使わない）
# 発行: Blueskyアプリ → 設定 → プライバシーとセキュリティ → アプリパスワード
BSKY_HANDLE=cir-ix.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- X (Twitter) ----
# developer.x.com → プロジェクトのアプリ → Keys and tokens
# アプリの権限を「Read and write」にしてから Access Token を発行すること
# （権限変更後は Access Token の再生成が必要）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
